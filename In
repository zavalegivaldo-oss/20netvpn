<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>ZeroNet VPN</title>

<style>
:root{
  --bg:#000;
  --card:#0A0A1A;
  --blue:#1565C0;
  --blue-dark:#0A0E4A;
  --green:#10B981;
  --white:#FFF;
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  font-family:Arial,Helvetica,sans-serif;
  -webkit-tap-highlight-color:transparent;
}

body{
  background:var(--bg);
  color:var(--white);
  max-width:420px;
  margin:0 auto;
  min-height:100vh;
  display:flex;
  flex-direction:column;
  position:relative;
  overflow-x:hidden;
  padding-bottom:46px;
}

header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:10px 16px;
  background:#05050F;
  position:relative;
  z-index:20;
}

.logo-box{
  background:#000;
  padding:6px 10px;
  border-radius:4px;
  border-bottom:3px solid var(--blue);
}

.logo{
  font-size:22px;
  font-weight:900;
  letter-spacing:2px;
  line-height:1;
}

.logo .accent{
  color:var(--blue);
  font-size:26px;
}

.logo-sub{
  font-size:9px;
  color:#aaa;
  margin-top:2px;
  letter-spacing:1px;
}

.menu{
  width:28px;
  display:flex;
  flex-direction:column;
  gap:5px;
  cursor:pointer;
}

.menu span{
  height:2px;
  background:var(--blue);
  border-radius:2px;
}

/* MENU - ABRE DO LADO ESQUERDO */

.side-menu{
  position:fixed;
  top:0;
  left:-310px;
  right:auto;
  width:290px;
  max-width:82vw;
  height:100vh;
  background:#05050F;
  border-right:1px solid var(--blue-dark);
  z-index:100;
  padding:22px 16px;
  transition:left .3s ease;
  overflow-y:auto;
  box-shadow:10px 0 30px rgba(0,0,0,.6);
}

.side-menu.open{
  left:0;
}

.menu-title{
  font-size:18px;
  font-weight:900;
  color:var(--blue);
  margin-bottom:18px;
}

.menu-close{
  position:absolute;
  left:16px;
  right:auto;
  top:16px;
  color:#aaa;
  font-size:25px;
  cursor:pointer;
}

.menu-title{
  padding-left:38px;
}

.menu-item{
  display:flex;
  align-items:center;
  gap:12px;
  padding:14px 10px;
  margin-bottom:7px;
  border:1px solid #111a35;
  border-radius:9px;
  background:#09091A;
  cursor:pointer;
}

.menu-item:hover{
  border-color:var(--blue);
}

.menu-code{
  width:45px;
  color:var(--blue);
  font-size:12px;
  font-weight:900;
}

.menu-name{
  font-size:13px;
  font-weight:700;
}

.overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.65);
  z-index:90;
  display:none;
}

.overlay.show{
  display:block;
}

/* BARRA 180 DIAS */

.activation-bar{
  position:fixed;
  bottom:0;
  left:50%;
  transform:translateX(-50%);
  width:100%;
  max-width:420px;
  min-height:46px;
  background:#1565C0;
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:10px 15px;
  font-size:13px;
  font-weight:900;
  letter-spacing:.5px;
  z-index:200;
  box-shadow:0 -4px 18px rgba(21,101,192,.35);
}

/* CONTENT */

.screen{
  flex:1;
  overflow-y:auto;
  padding:16px 16px 30px;
}

.page{
  display:none;
}

.page.active{
  display:block;
}

.page-title{
  font-size:20px;
  font-weight:900;
  margin-bottom:5px;
}

.page-subtitle{
  color:#7799CC;
  font-size:11px;
  margin-bottom:20px;
}

/* VPN */

.top-select{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
  margin-bottom:20px;
}

.select-card{
  background:var(--card);
  border-radius:10px;
  padding:12px 14px;
  border:1px solid var(--blue-dark);
  cursor:pointer;
  border-top:2px solid var(--blue);
}

.select-card label{
  font-size:11px;
  color:#7799CC;
  letter-spacing:1px;
  font-weight:700;
}

.select-card .val{
  font-size:15px;
  color:var(--blue);
  font-weight:900;
  margin-top:4px;
}

.status{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  font-weight:900;
  font-size:13px;
  margin-bottom:16px;
  text-align:center;
  min-height:20px;
  letter-spacing:1px;
}

.status-dot{
  width:10px;
  height:10px;
  border-radius:50%;
  background:#555;
  flex-shrink:0;
}

.status.connected{
  color:var(--green);
}

.status.connected .status-dot{
  background:var(--green);
  box-shadow:0 0 8px var(--green);
}

.status.connecting .status-dot{
  background:var(--blue);
  animation:blink 1s infinite;
}

.status.error{
  color:#FF5555;
}

.status.error .status-dot{
  background:#FF5555;
}

@keyframes blink{
  50%{opacity:.3}
}

.btn-wrap{
  width:190px;
  height:190px;
  margin:0 auto 24px;
  position:relative;
}

.btn-circle{
  width:190px;
  height:190px;
  border-radius:50%;
  position:absolute;
  top:0;
  left:0;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:900;
  font-size:16px;
  color:var(--white);
  cursor:pointer;
  background:#0A0A1A;
  box-shadow:inset 0 0 0 8px #000;
  text-align:center;
  padding:0 20px;
  letter-spacing:2px;
}

.btn-circle::before{
  content:'';
  position:absolute;
  width:148px;
  height:148px;
  border-radius:50%;
  background:#000;
  z-index:1;
}

.btn-circle span{
  position:relative;
  z-index:2;
}

.btn-circle.on{
  background:#052a1a;
  box-shadow:
    inset 0 0 0 8px #000,
    0 0 20px rgba(16,185,129,.3);
}

.progress{
  position:absolute;
  top:0;
  left:0;
  width:190px;
  height:190px;
  transform:rotate(-90deg);
  z-index:3;
  pointer-events:none;
}

.progress circle{
  fill:none;
  stroke-width:7;
  stroke-linecap:round;
}

.progress .bg{
  stroke:#0A0A1A;
}

.progress .bar{
  stroke:var(--blue);
  stroke-dasharray:535;
  stroke-dashoffset:535;
  transition:stroke-dashoffset .08s linear,stroke .5s;
}

.progress.connected .bar{
  stroke:var(--green);
}

.stats-2{
  display:grid;
  grid-template-columns:1fr auto 1fr;
  gap:10px;
  align-items:center;
  margin-bottom:14px;
}

.stat-box{
  background:var(--card);
  border:2px solid var(--blue-dark);
  border-radius:10px;
  padding:14px;
  text-align:center;
  border-top:2px solid var(--blue);
}

.stat-box.active{
  border-top-color:var(--green);
}

.stat-box .arrow{
  font-size:20px;
  color:var(--blue);
  line-height:1;
  margin-bottom:4px;
}

.stat-box.active .arrow{
  color:var(--green);
}

.stat-box.down .arrow{
  transform:rotate(180deg);
}

.stat-box .val{
  font-size:26px;
  font-weight:900;
  line-height:1;
}

.stat-box .unit{
  font-size:11px;
  color:#7799CC;
  margin-left:2px;
}

.stat-box .lbl{
  font-size:10px;
  color:#7799CC;
  margin-top:4px;
  font-weight:700;
  letter-spacing:1px;
}

.refresh-btn{
  width:50px;
  height:50px;
  border-radius:50%;
  background:var(--blue);
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:22px;
  font-weight:700;
  cursor:pointer;
}

.grid-2{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin-bottom:10px;
}

.card{
  background:var(--card);
  border-radius:10px;
  padding:13px;
  border:1px solid var(--blue-dark);
  border-left:3px solid var(--blue);
}

.card label{
  font-size:10px;
  color:#7799CC;
  font-weight:700;
}

.card .val{
  font-size:18px;
  font-weight:900;
  margin-top:4px;
}

.graph-card{
  background:var(--card);
  border-radius:10px;
  padding:14px;
  border:1px solid var(--blue-dark);
  border-left:3px solid var(--blue);
  margin-bottom:10px;
}

.graph-card label{
  font-size:10px;
  color:#7799CC;
  font-weight:700;
  display:block;
  margin-bottom:8px;
}

.graph-wrap{
  position:relative;
  width:100%;
  height:80px;
}

#speedGraph{
  width:100%;
  height:80px;
  display:block;
}

/* CODIGO */

.code-card{
  background:var(--card);
  border:1px solid var(--blue-dark);
  border-top:3px solid var(--blue);
  border-radius:12px;
  padding:20px;
  text-align:center;
  margin-top:15px;
}

.code-label{
  color:#7799CC;
  font-size:11px;
  font-weight:700;
  letter-spacing:1px;
  margin-bottom:12px;
}

.code-number{
  background:#000;
  border:1px solid #16285A;
  border-radius:10px;
  padding:18px 10px;
  font-size:28px;
  font-weight:900;
  letter-spacing:5px;
  color:var(--blue);
  margin-bottom:15px;
  word-break:break-all;
}

.code-actions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}

.action-btn{
  border:0;
  border-radius:9px;
  padding:14px 8px;
  color:#fff;
  background:var(--blue);
  font-weight:900;
  cursor:pointer;
}

.action-btn.secondary{
  background:#10182E;
  border:1px solid var(--blue);
}

.message{
  min-height:18px;
  margin-top:12px;
  color:var(--green);
  font-size:11px;
  font-weight:700;
}

/* GENERIC */

.option-card{
  background:var(--card);
  border:1px solid var(--blue-dark);
  border-left:3px solid var(--blue);
  border-radius:10px;
  padding:15px;
  margin-bottom:10px;
}

.option-card h3{
  font-size:14px;
  margin-bottom:6px;
}

.option-card p{
  color:#8CA2C8;
  font-size:11px;
  line-height:1.5;
}

.danger{
  border-left-color:#ef4444;
}

.danger button{
  background:#991b1b;
}

.hidden{
  display:none!important;
}
</style>
</head>

<body>

<header>
  <div class="logo-box">
    <div class="logo">ZERO<span class="accent">N</span>ET</div>
    <div class="logo-sub">ZeroNet VPN • SECURE</div>
  </div>

  <div class="menu" onclick="openMenu()">
    <span></span>
    <span></span>
    <span></span>
  </div>
</header>

<div class="overlay" id="overlay" onclick="closeMenu()"></div>

<nav class="side-menu" id="sideMenu">

  <div class="menu-close" onclick="closeMenu()">×</div>

  <div class="menu-title">MENU</div>

  <div class="menu-item" onclick="showPage('config')">
    <div class="menu-code">CFG</div>
    <div class="menu-name">Configurações</div>
  </div>

  <div class="menu-item" onclick="showPage('countries')">
    <div class="menu-code">NET</div>
    <div class="menu-name">Países</div>
  </div>

  <div class="menu-item" onclick="showPage('servers')">
    <div class="menu-code">SRV</div>
    <div class="menu-name">Servidores</div>
  </div>

  <div class="menu-item" onclick="showPage('stats')">
    <div class="menu-code">EST</div>
    <div class="menu-name">Estatísticas</div>
  </div>

  <div class="menu-item" onclick="showPage('register')">
    <div class="menu-code">REG</div>
    <div class="menu-name">Fazer o meu registo</div>
  </div>

  <div class="menu-item" onclick="showPage('premium')">
    <div class="menu-code">PRO</div>
    <div class="menu-name">Plano Premium</div>
  </div>

  <div class="menu-item" onclick="showPage('support')">
    <div class="menu-code">SUP</div>
    <div class="menu-name">Ajuda &amp; Suporte</div>
  </div>

  <div class="menu-item" onclick="showPage('about')">
    <div class="menu-code">INF</div>
    <div class="menu-name">Sobre</div>
  </div>

  <div class="menu-item" onclick="showPage('netplus')">
    <div class="menu-code">NET+</div>
    <div class="menu-name">Conexões / Partilha Net</div>
  </div>

  <div class="menu-item" onclick="showPage('code')">
    <div class="menu-code">COD</div>
    <div class="menu-name">Adicionar Código</div>
  </div>

  <div class="menu-item" onclick="showPage('delete')">
    <div class="menu-code">DEL</div>
    <div class="menu-name">Cancelar conta / inscrição</div>
  </div>

</nav>

<div class="screen">

  <section class="page active" id="home">

    <div class="top-select">

      <div class="select-card">
        <label>SERVIDOR</label>
        <div class="val" id="servidorLabel">Maputo 01</div>
      </div>

      <div class="select-card">
        <label>PAÍS</label>
        <div class="val" id="paisLabel">Moçambique</div>
      </div>

    </div>

    <div class="status" id="statusRow">
      <div class="status-dot"></div>
      <span id="statusTxt">DESCONECTADO</span>
    </div>

    <div class="btn-wrap">

      <svg class="progress" id="progressSvg" viewBox="0 0 190 190">

        <circle
          class="bg"
          cx="95"
          cy="95"
          r="85">
        </circle>

        <circle
          class="bar"
          id="bar"
          cx="95"
          cy="95"
          r="85">
        </circle>

      </svg>

      <div
        class="btn-circle"
        id="btnCircle"
        onclick="toggle()">

        <span id="btnTxt">CONECTAR</span>

      </div>

    </div>

    <div class="stats-2">

      <div class="stat-box down" id="boxDown">

        <div class="arrow">↓</div>

        <div>
          <span class="val" id="downVal">0</span>
          <span class="unit" id="downUnit">KB</span>
        </div>

        <div class="lbl">DOWNLOAD</div>

      </div>

      <div
        class="refresh-btn"
        onclick="reset()">
        ↻
      </div>

      <div class="stat-box up" id="boxUp">

        <div class="arrow">↑</div>

        <div>
          <span class="val" id="upVal">0</span>
          <span class="unit" id="upUnit">KB</span>
        </div>

        <div class="lbl">UPLOAD</div>

      </div>

    </div>

    <div class="graph-card">

      <label>
        VELOCIDADE EM TEMPO REAL (MB/s)
      </label>

      <div class="graph-wrap">

        <canvas id="speedGraph"></canvas>

      </div>

    </div>

    <div class="grid-2">

      <div class="card">
        <label>TEMPO</label>
        <div class="val" id="tempo">00:00:00</div>
      </div>

      <div class="card">
        <label>PING</label>
        <div class="val" id="ping">-- ms</div>
      </div>

    </div>

    <div class="grid-2">

      <div class="card">
        <label>IP ATUAL</label>
        <div class="val" id="ip">192.168.1.1</div>
      </div>

      <div class="card">
        <label>IP VPN</label>
        <div class="val" id="ipvpn">--.--</div>
      </div>

    </div>

  </section>

  <section class="page" id="config">

    <div class="page-title">Configurações</div>
    <div class="page-subtitle">
      Configure o comportamento da aplicação.
    </div>

    <div class="option-card">
      <h3>Conexão automática</h3>
      <p>
        Permitir que a aplicação inicie a conexão automaticamente.
      </p>
    </div>

    <div class="option-card">
      <h3>Notificações</h3>
      <p>
        Gerenciar avisos de conexão e desconexão.
      </p>
    </div>

  </section>

  <section class="page" id="countries">

    <div class="page-title">Países</div>

    <div class="page-subtitle">
      Selecione o país do servidor.
    </div>

    <div
      class="option-card"
      onclick="selectCountry('Moçambique')">

      <h3>🇲🇿 Moçambique</h3>
      <p>Servidores disponíveis em Moçambique.</p>

    </div>

    <div
      class="option-card"
      onclick="selectCountry('África do Sul')">

      <h3>🇿🇦 África do Sul</h3>
      <p>Servidores disponíveis.</p>

    </div>

    <div
      class="option-card"
      onclick="selectCountry('Portugal')">

      <h3>🇵🇹 Portugal</h3>
      <p>Servidores disponíveis.</p>

    </div>

  </section>

  <section class="page" id="servers">

    <div class="page-title">Servidores</div>

    <div class="page-subtitle">
      Escolha um servidor disponível.
    </div>

    <div
      class="option-card"
      onclick="selectServer('Maputo 01')">

      <h3>Maputo 01</h3>
      <p>Servidor principal • Disponível</p>

    </div>

    <div
      class="option-card"
      onclick="selectServer('Maputo 02')">

      <h3>Maputo 02</h3>
      <p>Servidor alternativo • Disponível</p>

    </div>

    <div
      class="option-card"
      onclick="selectServer('Beira 01')">

      <h3>Beira 01</h3>
      <p>Servidor alternativo • Disponível</p>

    </div>

  </section>

  <section class="page" id="stats">

    <div class="page-title">Estatísticas</div>

    <div class="page-subtitle">
      Resumo da sua sessão atual.
    </div>

    <div class="grid-2">

      <div class="card">
        <label>DOWNLOAD</label>
        <div class="val" id="statDown">0 KB</div>
      </div>

      <div class="card">
        <label>UPLOAD</label>
        <div class="val" id="statUp">0 KB</div>
      </div>

    </div>

    <div class="card">
      <label>TEMPO DE CONEXÃO</label>
      <div class="val" id="statTime">00:00:00</div>
    </div>

  </section>

  <section class="page" id="register">

    <div class="page-title">
      Fazer o meu registo
    </div>

    <div class="page-subtitle">
      Registe a sua conta no ZeroNet VPN.
    </div>

    <div class="option-card">

      <h3>Registo</h3>

      <p>
        Área destinada ao registo e ativação da conta.
      </p>

    </div>

  </section>

  <section class="page" id="premium">

    <div class="page-title">Plano Premium</div>

    <div class="page-subtitle">
      Consulte as opções Premium.
    </div>

    <div class="option-card">

      <h3>ZeroNet Premium</h3>

      <p>
        Tenha acesso às funcionalidades Premium disponíveis para a sua conta.
      </p>

    </div>

  </section>

  <section class="page" id="support">

    <div class="page-title">Ajuda &amp; Suporte</div>

    <div class="page-subtitle">
      Encontre ajuda para utilizar a aplicação.
    </div>

    <div class="option-card">

      <h3>Suporte</h3>

      <p>
        Consulte as informações de suporte e resolução de problemas.
      </p>

    </div>

  </section>

  <section class="page" id="about">

    <div class="page-title">Sobre</div>

    <div class="page-subtitle">
      Informações sobre o ZeroNet VPN.
    </div>

    <div class="option-card">

      <h3>ZeroNet VPN</h3>

      <p>
        Aplicação de demonstração de interface VPN.
      </p>

    </div>

  </section>

  <section class="page" id="netplus">

    <div class="page-title">
      Conexões / Partilha Net
    </div>

    <div class="page-subtitle">
      Gerencie as opções de conexão e partilha.
    </div>

    <div class="option-card">

      <h3>Partilha Net</h3>

      <p>
        Área destinada às opções de partilha de conexão.
      </p>

    </div>

    <!-- CÓDIGO DE 6 DÍGITOS -->

    <div class="code-card">

      <div class="code-label">
        CÓDIGO DE PARTILHA
      </div>

      <div
        class="code-number"
        id="netCodeNumber">
        000000
      </div>

      <div class="code-actions">

        <button
          class="action-btn"
          onclick="copyNetCode()">
          COPIAR
        </button>

        <button
          class="action-btn secondary"
          onclick="updateNetCode()">
          ATUALIZAR
        </button>

      </div>

      <div
        class="message"
        id="netCodeMessage">
      </div>

    </div>

  </section>

  <section class="page" id="code">

    <div class="page-title">
      Adicionar Código
    </div>

    <div class="page-subtitle">
      Utilize o código apresentado abaixo.
    </div>

    <div class="code-card">

      <div class="code-label">
        CÓDIGO ATUAL
      </div>

      <div
        class="code-number"
        id="codeNumber">
        000000
      </div>

      <div class="code-actions">

        <button
          class="action-btn"
          onclick="copyCode()">
          COPIAR
        </button>

        <button
          class="action-btn secondary"
          onclick="updateCode()">
          ATUALIZAR CÓDIGO
        </button>

      </div>

      <div
        class="message"
        id="codeMessage">
      </div>

    </div>

  </section>

  <section class="page" id="delete">

    <div class="page-title">
      Cancelar conta / inscrição
    </div>

    <div class="page-subtitle">
      Área de gerenciamento da inscrição.
    </div>

    <div class="option-card danger">

      <h3>Cancelar inscrição</h3>

      <p>
        Esta área permite iniciar o processo de cancelamento da inscrição.
      </p>

      <br>

      <button
        class="action-btn"
        onclick="cancelRegistration()">
        CANCELAR INSCRIÇÃO
      </button>

    </div>

    <div
      class="message"
      id="deleteMessage">
    </div>

  </section>

</div>

<!-- BARRA AZUL INFERIOR -->

<div class="activation-bar">
  PACOTE DE 180 DIAS ATIVADO
</div>

<script>

const CIRC = 535;

let estado = 'desconectado';
let seg = 0;
let downKB = 0;
let upKB = 0;
let loopT = null;
let connectT = null;

const canvas =
  document.getElementById('speedGraph');

const ctx =
  canvas.getContext('2d');

const MAX_PTS = 50;

let pts =
  new Array(MAX_PTS).fill(0);

let graphTick = 0;

/* MENU */

function openMenu(){

  document
    .getElementById('sideMenu')
    .classList.add('open');

  document
    .getElementById('overlay')
    .classList.add('show');

}

function closeMenu(){

  document
    .getElementById('sideMenu')
    .classList.remove('open');

  document
    .getElementById('overlay')
    .classList.remove('show');

}

/* PÁGINAS */

function showPage(id){

  document
    .querySelectorAll('.page')
    .forEach(p => {
      p.classList.remove('active');
    });

  const page =
    document.getElementById(id);

  if(page){
    page.classList.add('active');
  }

  closeMenu();

  const screen =
    document.querySelector('.screen');

  screen.scrollTop = 0;

}

function goHome(){
  showPage('home');
}

/* CÓDIGO */

function generateCode(){

  const chars =
    '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ';

  let code = '';

  for(let i = 0; i < 6; i++){

    code += chars.charAt(
      Math.floor(
        Math.random() * chars.length
      )
    );

  }

  return code;

}

/* CÓDIGO DA ABA ADICIONAR CÓDIGO */

function updateCode(){

  const newCode =
    generateCode();

  document
    .getElementById('codeNumber')
    .textContent = newCode;

  const msg =
    document.getElementById('codeMessage');

  msg.textContent =
    'Código atualizado.';

  setTimeout(() => {
    msg.textContent = '';
  },2000);

}

async function copyCode(){

  const code =
    document
      .getElementById('codeNumber')
      .textContent
      .trim();

  const msg =
    document.getElementById('codeMessage');

  try{

    await navigator.clipboard.writeText(code);

    msg.textContent =
      'Código copiado.';

  }catch(e){

    const area =
      document.createElement('textarea');

    area.value = code;

    document.body.appendChild(area);

    area.select();

    document.execCommand('copy');

    area.remove();

    msg.textContent =
      'Código copiado.';

  }

  setTimeout(() => {
    msg.textContent = '';
  },2000);

}

/* CÓDIGO DA PARTILHA NET */

function updateNetCode(){

  const newCode =
    generateCode();

  document
    .getElementById('netCodeNumber')
    .textContent = newCode;

  const msg =
    document.getElementById('netCodeMessage');

  msg.textContent =
    'Código atualizado.';

  setTimeout(() => {
    msg.textContent = '';
  },2000);

}

async function copyNetCode(){

  const code =
    document
      .getElementById('netCodeNumber')
      .textContent
      .trim();

  const msg =
    document.getElementById('netCodeMessage');

  try{

    await navigator.clipboard.writeText(code);

    msg.textContent =
      'Código copiado.';

  }catch(e){

    const area =
      document.createElement('textarea');

    area.value = code;

    document.body.appendChild(area);

    area.select();

    document.execCommand('copy');

    area.remove();

    msg.textContent =
      'Código copiado.';

  }

  setTimeout(() => {
    msg.textContent = '';
  },2000);

}

/* CANCELAMENTO */

function cancelRegistration(){

  document
    .getElementById('deleteMessage')
    .textContent =
    'Solicitação de cancelamento selecionada.';

}

/* PAÍS / SERVIDOR */

function selectCountry(country){

  document
    .getElementById('paisLabel')
    .textContent = country;

  showPage('home');

}

function selectServer(server){

  document
    .getElementById('servidorLabel')
    .textContent = server;

  showPage('home');

}

/* CONEXÃO */

function toggle(){

  if(estado === 'conectando')
    return;

  if(estado === 'conectado'){

    desconectar();

    return;

  }

  conectar();

}

function conectar(){

  estado = 'conectando';

  document
    .getElementById('btnTxt')
    .textContent = 'AGUARDE';

  setStatus(
    'connecting',
    'A VERIFICAR REDE...'
  );

  document
    .getElementById('progressSvg')
    .classList.remove('connected');

  document
    .getElementById('bar')
    .style.strokeDashoffset = CIRC;

  document
    .getElementById('btnCircle')
    .classList.remove('on');

  const phases = [

    {
      pct:15,
      txt:'VERIFICANDO SERVIDOR...'
    },

    {
      pct:35,
      txt:'ESTABELECENDO TÚNEL...'
    },

    {
      pct:60,
      txt:'ENCRIPTANDO DADOS...'
    },

    {
      pct:85,
      txt:'QUASE PRONTO...'
    }

  ];

  let phaseIdx = 0;
  let p = 0;

  connectT =
    setInterval(() => {

      p += 1.3;

      document
        .getElementById('bar')
        .style.strokeDashoffset =
        CIRC -
        (CIRC * p / 100);

      if(
        phaseIdx < phases.length &&
        p >= phases[phaseIdx].pct
      ){

        setStatus(
          'connecting',
          phases[phaseIdx].txt
        );

        phaseIdx++;

      }

      if(p >= 100){

        clearInterval(connectT);

        onConnected();

      }

    },45);

}

function onConnected(){

  estado = 'conectado';

  document
    .getElementById('progressSvg')
    .classList.add('connected');

  document
    .getElementById('bar')
    .style.strokeDashoffset = 0;

  document
    .getElementById('btnCircle')
    .classList.add('on');

  document
    .getElementById('btnTxt')
    .textContent = 'CONECTADO';

  setStatus(
    'connected',
    'CONECTADO'
  );

  document
    .getElementById('boxDown')
    .classList.add('active');

  document
    .getElementById('boxUp')
    .classList.add('active');

  document
    .getElementById('ping')
    .textContent =
    rand(18,42) + ' ms';

  document
    .getElementById('ipvpn')
    .textContent =
    '10.' +
    rand(10,200) + '.' +
    rand(0,255) + '.' +
    rand(1,254);

  seg = 0;
  downKB = 0;
  upKB = 0;
  graphTick = 0;

  startLoop();

}

function startLoop(){

  clearInterval(loopT);

  loopT =
    setInterval(() => {

      seg++;

      const h =
        Math.floor(seg / 3600);

      const m =
        Math.floor(
          (seg % 3600) / 60
        );

      const s =
        seg % 60;

      const tempo =
        pad(h) + ':' +
        pad(m) + ':' +
        pad(s);

      document
        .getElementById('tempo')
        .textContent = tempo;

      document
        .getElementById('statTime')
        .textContent = tempo;

      const baseDown =
        0.18 +
        (seg * 0.012);

      const baseUp =
        0.03 +
        (seg * 0.0018);

      downKB +=
        (
          baseDown +
          Math.random() *
          baseDown *
          .4
        ) * 1024;

      upKB +=
        (
          baseUp +
          Math.random() *
          baseUp *
          .4
        ) * 1024;

      fmtStat(
        downKB,
        'downVal',
        'downUnit'
      );

      fmtStat(
        upKB,
        'upVal',
        'upUnit'
      );

      document
        .getElementById('statDown')
        .textContent =
        formatSimple(downKB);

      document
        .getElementById('statUp')
        .textContent =
        formatSimple(upKB);

      pushPt(graphValue());

    },1000);

}

function desconectar(){

  clearInterval(loopT);
  clearInterval(connectT);

  loopT = null;
  connectT = null;

  estado = 'desconectado';

  document
    .getElementById('progressSvg')
    .classList.remove('connected');

  document
    .getElementById('bar')
    .style.strokeDashoffset = CIRC;

  document
    .getElementById('btnCircle')
    .classList.remove('on');

  document
    .getElementById('btnTxt')
    .textContent = 'CONECTAR';

  setStatus(
    '',
    'DESCONECTADO'
  );

  document
    .getElementById('boxDown')
    .classList.remove('active');

  document
    .getElementById('boxUp')
    .classList.remove('active');

  document
    .getElementById('ipvpn')
    .textContent = '--.--';

  document
    .getElementById('ping')
    .textContent = '-- ms';

}

function reset(){

  if(estado !== 'conectado')
    return;

  seg = 0;
  downKB = 0;
  upKB = 0;
  graphTick = 0;

  pts =
    new Array(MAX_PTS).fill(0);

  document
    .getElementById('tempo')
    .textContent = '00:00:00';

  document
    .getElementById('statTime')
    .textContent = '00:00:00';

  document
    .getElementById('downVal')
    .textContent = '0';

  document
    .getElementById('downUnit')
    .textContent = 'KB';

  document
    .getElementById('upVal')
    .textContent = '0';

  document
    .getElementById('upUnit')
    .textContent = 'KB';

  document
    .getElementById('statDown')
    .textContent = '0 KB';

  document
    .getElementById('statUp')
    .textContent = '0 KB';

  drawGraph();

}

/* STATUS */

function setStatus(cls,txt){

  const row =
    document.getElementById('statusRow');

  row.className =
    'status' +
    (cls ? ' ' + cls : '');

  document
    .getElementById('statusTxt')
    .textContent = txt;

}

/* ESTATÍSTICAS */

function fmtStat(kb,elV,elU){

  const el =
    document.getElementById(elV);

  const eu =
    document.getElementById(elU);

  if(kb >= 1024 * 1024){

    el.textContent =
      (kb / (1024 * 1024))
      .toFixed(2);

    eu.textContent = 'GB';

  }else if(kb >= 1024){

    el.textContent =
      (kb / 1024)
      .toFixed(1);

    eu.textContent = 'MB';

  }else{

    el.textContent =
      Math.floor(kb);

    eu.textContent = 'KB';

  }

}

function formatSimple(kb){

  if(kb >= 1024 * 1024)
    return (
      kb / (1024 * 1024)
    ).toFixed(2) + ' GB';

  if(kb >= 1024)
    return (
      kb / 1024
    ).toFixed(1) + ' MB';

  return Math.floor(kb) + ' KB';

}

/* GRÁFICO */

function resizeCanvas(){

  canvas.width =
    canvas.parentElement.clientWidth - 36;

  canvas.height = 80;

}

function drawGraph(){

  const w = canvas.width;
  const h = canvas.height;

  if(!w || !h)
    return;

  ctx.clearRect(
    0,
    0,
    w,
    h
  );

  const levels =
    [0,2,5,7,10];

  ctx.setLineDash([2,4]);

  ctx.strokeStyle =
    '#0a1030';

  ctx.lineWidth = 1;

  levels.forEach(level => {

    const y =
      h -
      (level / 10) * h;

    ctx.beginPath();

    ctx.moveTo(0,y);

    ctx.lineTo(w,y);

    ctx.stroke();

  });

  ctx.setLineDash([]);

  const step =
    w / (MAX_PTS - 1);

  ctx.beginPath();

  pts.forEach((v,i) => {

    const x =
      i * step;

    const y =
      h -
      (Math.min(v,10) / 10) * h;

    if(i === 0)
      ctx.moveTo(x,y);
    else
      ctx.lineTo(x,y);

  });

  ctx.lineTo(w,h);
  ctx.lineTo(0,h);
  ctx.closePath();

  ctx.fillStyle =
    'rgba(21,101,192,.15)';

  ctx.fill();

  ctx.beginPath();

  pts.forEach((v,i) => {

    const x =
      i * step;

    const y =
      h -
      (Math.min(v,10) / 10) * h;

    if(i === 0)
      ctx.moveTo(x,y);
    else
      ctx.lineTo(x,y);

  });

  ctx.strokeStyle =
    '#1565C0';

  ctx.lineWidth = 2;

  ctx.stroke();

}

function pushPt(v){

  pts.shift();
  pts.push(v);

  drawGraph();

}

function graphValue(){

  graphTick++;

  const t =
    graphTick;

  let v;

  if(t <= 30){

    v =
      2 +
      2.5 *
      Math.sin(t * .35) +
      (t / 30) * 1.5 +
      Math.random() * .4;

  }else if(t <= 50){

    v =
      4 +
      .6 *
      Math.sin(t * .5) +
      Math.random() * .3;

  }else{

    const climb =
      Math.min(
        (t - 50) * .22,
        6
      );

    v =
      4 +
      climb +
      .3 *
      Math.sin(t * .8) +
      Math.random() * .2;

  }

  return Math.max(
    0,
    Math.min(v,10)
  );

}

/* UTILITÁRIOS */

function rand(a,b){

  return Math.floor(
    Math.random() *
    (b-a+1)
  ) + a;

}

function pad(n){

  return String(n)
    .padStart(2,'0');

}

/* INICIALIZAÇÃO */

window.addEventListener(
  'resize',
  () => {

    resizeCanvas();
    drawGraph();

  }
);

window.addEventListener(
  'load',
  () => {

    resizeCanvas();
    drawGraph();

    document
      .getElementById('codeNumber')
      .textContent =
      generateCode();

    document
      .getElementById('netCodeNumber')
      .textContent =
      generateCode();

  }
);

</script>

</body>
  </html>
